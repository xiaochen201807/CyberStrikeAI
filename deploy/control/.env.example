CYBERSTRIKE_BIND=127.0.0.1
CYBERSTRIKE_PORT=8080
CYBERSTRIKE_MEMORY_LIMIT=2g
CYBERSTRIKE_CPUS=2
CYBERSTRIKE_CONTROL_NETWORK=cyberstrike-control
