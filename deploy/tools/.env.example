# Images are pinned to multi-architecture manifest digests. Update both this
# file and catalog.yaml together when upgrading a scanner.
NUCLEI_IMAGE=projectdiscovery/nuclei:v3.4.10@sha256:aeb5ea2db32a252b8135707d2ad0e89b90e19a18ea7816d38759bc51efb46b97
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.16.1@sha256:7840969c7c9fead565bf9734b12f49f6886db90b1d35b1f74d79710bbd081dab

TOOLS_COMPOSE_PROJECT=cyberstrike-tools
TOOLS_EGRESS_NETWORK=cyberstrike-tools-egress
CYBERSTRIKE_CONTROL_NETWORK=cyberstrike-control

# Family runtime base. The digest is the current multi-architecture Kali
# rolling manifest used by the image factory.
TOOL_BASE_IMAGE=kalilinux/kali-rolling@sha256:c717f201f29a7e0a9126c0d51bd08aa7194ac82f53c57314339182f92b0b1585

# Optional published family images. Local development may keep the defaults;
# production should replace them with immutable GHCR references containing a
# sha256 digest.
# RECON_IMAGE=ghcr.io/xiaochen201807/cyberstrike-tool-runtime-recon:version@sha256:<digest>
# WEB_IMAGE=ghcr.io/xiaochen201807/cyberstrike-tool-runtime-web:version@sha256:<digest>
# IDENTITY_IMAGE=ghcr.io/xiaochen201807/cyberstrike-tool-runtime-identity:version@sha256:<digest>
# BINARY_IMAGE=ghcr.io/xiaochen201807/cyberstrike-tool-runtime-binary:version@sha256:<digest>
# CLOUD_IMAGE=ghcr.io/xiaochen201807/cyberstrike-tool-runtime-cloud:version@sha256:<digest>
# EXPLOITATION_IMAGE=ghcr.io/xiaochen201807/cyberstrike-tool-runtime-exploitation:version@sha256:<digest>
# EXTERNAL_INTEL_IMAGE=ghcr.io/xiaochen201807/cyberstrike-tool-runtime-external-intel:version@sha256:<digest>
# UTILITY_IMAGE=ghcr.io/xiaochen201807/cyberstrike-tool-runtime-utility:version@sha256:<digest>

# Required by the long-running MCP services. Generate with:
#   openssl rand -hex 32
TOOL_MCP_TOKEN=replace-with-a-random-32-byte-token
TOOL_MCP_AUTH_HEADER=X-Tool-Token

# Exact authorized host or a scoped subdomain pattern. Do not use '*'.
TOOL_ALLOWED_HOSTS=authorized.example.com,*.authorized.example.com

# Optional generic compatibility adapter. Point this at a family image that
# actually contains the selected commands; do not use one image for all tools.
# TOOL_RUNTIME_IMAGE=your-registry/cyberstrike-recon-runtime:version@sha256:<digest>
# Choose either TOOL_FAMILY or TOOL_IDS. A family selects the enabled tools
# from the repository inventory; the runtime image must contain every command.
# TOOL_FAMILY=recon
# TOOL_IDS=nmap,subfinder,amass
# TOOL_PRECHECK=1
# TOOL_REGISTRY_DIR=../../tools
# TOOL_WORKSPACE_DIR=./data/workspace

TARGETS_DIR=./data/targets
REPORTS_DIR=./data/reports
MAX_TARGETS=100
NUCLEI_SEVERITY=medium,high,critical
NUCLEI_RATE_LIMIT=30
NUCLEI_CONCURRENCY=10
NUCLEI_BULK_SIZE=1
NUCLEI_PIDS_LIMIT=256
ZAP_SPIDER_MINUTES=1
ZAP_LOCALE=zh_CN
ZAP_PIDS_LIMIT=256
